# Copy to `.env` (gitignored) to override the baked-in cloud URL.
# Shipped APK default (no .env needed): https://fleet-tracking-api.onrender.com/api/v1
#
# Examples:
#   Android emulator -> local backend:  API_BASE_URL=http://10.0.2.2:8000/api/v1
#   iOS simulator -> local backend:     API_BASE_URL=http://localhost:8000/api/v1
#   Chrome dev -> local backend:        API_BASE_URL=http://localhost:8000/api/v1
API_BASE_URL=https://fleet-tracking-api.onrender.com/api/v1
